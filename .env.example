# =============================================================================
# Transition Agent — copy to .env and fill in your values.
# =============================================================================
# Loaded automatically by config.py (real environment variables take precedence).
# Mirrors the variables in .env; real secrets/endpoints are placeholders here.

# --- Work IQ REST API -------------------------------------------------------
# Base up to and including the REST prefix (use .../rest for GA or .../rest/beta):
WORKIQ_REST_ENDPOINT=https://workiq.svc.cloud.microsoft/rest
# Delegated scope requested for the signed-in user to call Work IQ:
WORKIQ_SCOPE=fdcc1f02-fc51-4226-8753-f668596af7f7/WorkIQAgent.Ask
# Attempt the Work IQ collector; set false to always use the Microsoft Graph collector:
WORKIQ_ENABLED=true

# --- collection tuning ------------------------------------------------------
WORKIQ_MAX_WORKERS=4
WORKIQ_SECTION_TIMEOUT=180
WORKIQ_TZ=America/New_York

# --- per-section item caps --------------------------------------------------
# Maximum rows kept per section of the brief. Applied by BOTH collectors (Work IQ
# and Microsoft Graph), so a section holds the same number of rows whichever
# source produced it. Minimum 1.
# Note: raising MAX_IMPORTANT_FILES also slows a refresh when GRAPH_DETECT_PII=true
# (each extra file costs two more Graph calls to resolve its sensitivity label).
MAX_CONTACTS=20
MAX_PROJECTS=20
MAX_IMPORTANT_FILES=20
MAX_RECURRING_PROCESSES=20
MAX_OUTSTANDING_ITEMS=20
MAX_ACCESS_TRANSFERS=20

# --- Azure Cosmos DB (primary handover store) -------------------------------
# Store briefs in Cosmos DB. Authenticate with a managed identity / az login
# (leave COSMOS_KEY unset) or an account key. Pre-create the database + container
# (partition key /id) or grant "Cosmos DB Built-in Data Contributor".
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# Optional account key; omit to authenticate with a managed identity / az login:
# COSMOS_KEY=<account-key>
COSMOS_DATABASE=transition-agent
COSMOS_CONTAINER=handovers
# false = use your az-login identity (local dev); true = app managed identity
# (needs the "Cosmos DB Built-in Data Contributor" role on the account).
COSMOS_USE_MANAGED_IDENTITY=false
# Client id of a USER-assigned managed identity (blank = system-assigned):
# COSMOS_MANAGED_IDENTITY_CLIENT_ID=

# --- Microsoft Entra ID web sign-in -----------------------------------------
# Register a confidential web app, add a client secret, set the redirect URI to
# https://<host>/auth/callback, and grant the delegated Work IQ permission
# (WorkIQAgent.Ask) plus Microsoft Graph Files.Read.All + Sites.Read.All for the
# file-backup feature, all with admin consent. Sign-in is enforced once these
# are set (AUTH_ENABLED auto-on when client id + secret are present).
AAD_CLIENT_ID=<web-app-client-id>
AAD_CLIENT_SECRET=<web-app-client-secret>
AAD_TENANT_ID=<tenant-id>
AAD_REDIRECT_URI=http://localhost:3000/auth/callback
AAD_POST_LOGOUT_REDIRECT=http://localhost:3000/login
AUTH_ENABLED=true
# Scopes requested at sign-in. Use the Work IQ scope where Work IQ is provisioned;
# in a tenant without Work IQ, switch to the Graph scopes so sign-in still succeeds:
# AAD_LOGIN_SCOPES=fdcc1f02-fc51-4226-8753-f668596af7f7/WorkIQAgent.Ask
AAD_LOGIN_SCOPES=User.Read User.Read.All People.Read Files.Read.All Sites.Read.All Calendars.Read Mail.Read Tasks.Read Team.ReadBasic.All GroupMember.Read.All

# --- Microsoft Graph collection ---------------------------------------------
# Resolve each file's Purview sensitivity label to flag PII (2 extra Graph calls
# per labelled file). Needs the InformationProtectionPolicy.Read delegated scope.
GRAPH_DETECT_PII=true

# --- web server -------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# Waitress worker threads. Omit to auto-size from the host CPU count (min 8); set
# explicitly in a container with a fractional vCPU (cpu_count sees the node, not
# the cgroup quota).
WSGI_THREADS=16
# Max client connections accepted before queueing, and how long a slow/idle
# connection may hold a thread.
WSGI_CONNECTION_LIMIT=1000
WSGI_CHANNEL_TIMEOUT=300
# Max heavy refreshes running at once per process (in-process mode); excess
# callers get HTTP 429 and retry. In Redis mode, worker replicas set the ceiling.
MAX_CONCURRENT_REFRESHES=8
MAX_CONTENT_LENGTH=8388608
# Set a STABLE value in production so login sessions survive restarts:
# SECRET_KEY=<random-hex>
ENABLE_REFRESH=true
TRUST_PROXY=false
# Session cookie hardening. SESSION_COOKIE_SECURE defaults to the value of
# TRUST_PROXY (on behind an HTTPS ingress, off for plain-HTTP local dev) - a
# Secure cookie is never sent over http://localhost, which would break sign-in.
# SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=480

# --- Redis: shared state + refresh queue (stateless scale-out) ---------------
# Leave BLANK for local / single-node: the MSAL token cache and refresh state
# stay in process memory and refreshes run on a background thread. Set REDIS_HOST
# (or REDIS_URL) to make the web tier stateless - the token cache, refresh status,
# and the refresh queue move to Redis, and a separate worker (python worker.py)
# runs the refreshes. Provide either REDIS_URL or the discrete host/port/password.
# REDIS_URL=rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0
# REDIS_HOST=<name>.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_SSL=true
# REDIS_PASSWORD=<access-key>
# REDIS_QUEUE=ta:refresh:queue
# REDIS_JOB_TTL=3600           # seconds a finished job's status is kept
# REDIS_CACHE_TTL=604800       # seconds a user's token cache is kept (7 days)
# Refresh worker threads per worker replica (worker.py):
# WORKER_CONCURRENCY=4

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO

# --- file backup to Azure Blob Storage --------------------------------------
# Source files are read with the signed-in USER's identity (via Graph); the
# backup storage account is written to with the APP's MANAGED IDENTITY, since
# the user usually has no access to the storage account.
# Option A: authenticate with a connection string (overrides ACCOUNT_URL/identity):
# AZURE_STORAGE_CONNECTION_STRING=
# Option B: account URL + Entra RBAC (managed identity or az login):
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_BACKUP_CONTAINER=handover-backups
# Write to storage with the app's MANAGED IDENTITY (needs "Storage Blob Data
# Contributor"). Set false for local dev so it uses your az login identity.
AZURE_STORAGE_USE_MANAGED_IDENTITY=false
# Client id of a USER-assigned managed identity for storage (blank = system-assigned):
# AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID=
# 250 MB per file; 0 = unlimited
BACKUP_MAX_FILE_BYTES=262144000
BACKUP_ALLOW_INTERACTIVE=true